datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model DailyPuzzle {
  id           String         @id @default(cuid())
  date         DateTime       @unique
  shape        String         // JSON string representing the grid pattern
  boardSize    Int
  createdAt    DateTime       @default(now())
  UserProgress UserProgress[]
}

model UserProgress {
  id            String      @id @default(cuid())
  userId        String      // Cookie-based anonymous session ID
  dailyPuzzleId String
  puzzle        DailyPuzzle @relation(fields: [dailyPuzzleId], references: [id], onDelete: Cascade)
  guesses       String      // JSON string of guessed tiles array
  completed     Boolean     @default(false)
  score         Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([userId, dailyPuzzleId])
}