generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model DailyPuzzle {
  id           Int            @id @default(autoincrement())
  date         DateTime       @db.Date
  board        Json
  boardSize    Int
  createdAt    DateTime       @default(now())
  UserProgress UserProgress[]

  @@unique([date, boardSize])
}

model User {
  id               String         @id
  played           Int            @default(0)
  totalStars       Int            @default(0)
  currentStreak    Int            @default(0)
  bestStreak       Int            @default(0)
  starDistribution Int[]          @default([0, 0, 0, 0, 0, 0])
  createdAt        DateTime       @default(now())
  name             String?
  email            String?
  provider         String?
  providerId       String?
  countryCode      String?
  progress         UserProgress[]

  @@unique([provider, providerId])
}

enum GameStatus {
  playing
  won
  lost
}

model UserProgress {
  id                Int         @id @default(autoincrement())
  userId            String
  puzzleId          Int
  hintCoordinates   Json        @default("[]")
  hintCount         Int         @default(0)
  status            GameStatus  @default(playing)
  stars             Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id])
  puzzle            DailyPuzzle @relation(fields: [puzzleId], references: [id])

  @@unique([userId, puzzleId])
}
